# ==============================================================================
# Knowledge Mining Agent (Student AI) Environment Configuration
# ==============================================================================
# Copy this file to .env and configure the credentials and endpoints below.
# DO NOT commit your .env file or API credentials to version control.

# ------------------------------------------------------------------------------
# Microsoft Azure AI Foundry Configuration
# ------------------------------------------------------------------------------
# The project endpoint URL from your Azure AI Foundry portal
FOUNDRY_PROJECT_ENDPOINT=https://your-resource-name.services.ai.azure.com/api/projects/your-project-name

# The name of your configured agent in Azure AI Foundry
FOUNDRY_AGENT_NAME=student-ai-agent

# ------------------------------------------------------------------------------
# Notion Integration Configuration
# ------------------------------------------------------------------------------
# Internal Integration Secret Token (starts with secret_...)
NOTION_TOKEN=secret_your_notion_integration_token_here

# Notion Database / Data Source ID (from your database URL)
NOTION_DATA_SOURCE_ID=your_notion_database_id_here

# ------------------------------------------------------------------------------
# Server Configuration (Optional)
# ------------------------------------------------------------------------------
PORT=5000
DEBUG=True
